# Supabase Postgres — get both from the Supabase dashboard's "Connect" panel.
#
# DATABASE_URL: runtime connection used by the app itself (server/prisma/client.ts, and the
# deployed Netlify Function). Use the *transaction-mode pooler* (port 6543, pgbouncer=true) —
# a serverless function creates a new connection per invocation, and the pooler is what keeps
# that from exhausting Supabase's direct connection limit.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# DIRECT_URL: used only by the Prisma CLI (migrate/db push/introspect — see prisma.config.ts).
# Use the *session-mode* connection (port 5432) — the transaction pooler doesn't support the
# advisory locks/DDL that migrations need.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

PORT=3001

# Used only by `server/prisma/seed.ts` to create the initial (and, in V1, only) admin user.
# Change these before running the seed against anything beyond local development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Production only (set as a Netlify site environment variable, not here): NODE_ENV=production
# — gates the session cookie's `Secure` flag in server/api/authRouter.ts. Netlify Functions
# don't set NODE_ENV=production automatically, so this must be set explicitly in the Netlify UI.
